programa
{
	funcao inicio()
	{
		inteiro numero
		inteiro pares = 0
		inteiro impares = 0
		inteiro i

		para (i = 1; i <= 5; i++)
		{
			escreva("Digite o ", i, "º número: ")
			leia(numero)

			se (numero % 2 == 0)
			{
				pares++
			}
			senao
			{
				impares++
			}
		}

		escreva("\nQuantidade de números pares: ", pares)
		escreva("\nQuantidade de números ímpares: ", impares)
	}
}
