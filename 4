programa
{
	funcao inicio()
	{
		real numero, maior
		inteiro i

		escreva("Digite o 1º número: ")
		leia(numero)

		maior = numero

		para (i = 2; i <= 5; i++)
		{
			escreva("Digite o ", i, "º número: ")
			leia(numero)

			se (numero > maior)
			{
				maior = numero
			}
		}

		escreva("\nO maior número é: ", maior)
	}
}
