programa
{
	funcao inicio()
	{
		inteiro n, numero
		inteiro menor, maior, soma = 0
		inteiro i

		escreva("Digite a quantidade de números: ")
		leia(n)

		escreva("Digite o 1º número (0 a 1000): ")
		leia(numero)

		enquanto (numero < 0 ou numero > 1000)
		{
			escreva("Número inválido! Digite um número entre 0 e 1000: ")
			leia(numero)
		}

		menor = numero
		maior = numero
		soma = numero

		para (i = 2; i <= n; i++)
		{
			escreva("Digite o ", i, "º número (0 a 1000): ")
			leia(numero)

			enquanto (numero < 0 ou numero > 1000)
			{
				escreva("Número inválido! Digite um número entre 0 e 1000: ")
				leia(numero)
			}

			soma = soma + numero

			se (numero < menor)
			{
				menor = numero
			}

			se (numero > maior)
			{
				maior = numero
			}
		}

		escreva("\nMenor valor: ", menor)
		escreva("\nMaior valor: ", maior)
		escreva("\nSoma dos valores: ", soma)
	}
}
